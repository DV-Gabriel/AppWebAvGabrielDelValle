<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!--50MB=50MB*1024KB*1024B-->
		<add key="maxSongLength" value="52428800"/>
		<add key="albumImagePath" value="~/albumImages/"/>
		<add key="artistImagePath" value="~/artistImages/"/>
		<add key="userPhotoPath" value="~/userImages/"/>
		<add key="songFolderPath" value="../songFiles/"/>
		<add key="playlistFolderPath" value="~/playlistImages/"/>
		<!-- Modulo de canciones: carpeta donde se guardan los audios subidos y tamano maximo por archivo -->
		<add key="SongUploadFolder" value="~/SongFiles"/>
		<add key="MaxSongFileSizeMB" value="25"/>
	</appSettings>
	<connectionStrings>
		<!-- SQL Server corre en Docker y publica el puerto 1433 del contenedor en el 14333 del host.
		     El puerto se indica con COMA (servidor,puerto). Con dos puntos ("localhost:14333")
		     SqlClient interpreta todo como nombre de servidor y falla con el error 40 de canalizaciones. -->
		<add name="BDD_PoliMusicConnectionString" connectionString="Data Source=localhost,14333;Initial Catalog=BDD_PoliMusic;User ID=usr_polimusic;Password=Politecnica1;Connect Timeout=15" providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<system.web>
		<compilation debug="true"/>
		<!--50MB to KB-->
		<httpRuntime maxRequestLength="51200"/>
		<authentication mode="Forms">
			<forms loginUrl="Login.aspx" defaultUrl="Default.aspx" timeout="20"/>
		</authentication>
		<authorization>
			<deny users="?"/>
		</authorization>
		<pages/>
	</system.web>
	<!-- Paginas publicas: sin esto el login quedaria bloqueado por el deny users="?" -->
	<location path="Login.aspx">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>
	<location path="SignUp.aspx">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>
	<location path="Logout.aspx">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>
	<location path="songFiles">
		<system.web>
			<httpRuntime maxRequestLength="51200"/>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>
	<system.webServer>
		<!-- Documento por defecto: evita el error 403.14 al entrar a http://localhost:16854/ -->
		<defaultDocument enabled="true">
			<files>
				<clear/>
				<add value="Default.aspx"/>
				<add value="Login.aspx"/>
			</files>
		</defaultDocument>
		<security>
			<requestFiltering>
				<!-- 50MB in bytes, default is 30000000 or approx. 28.6102 Mb-->
				<requestLimits maxAllowedContentLength="52428800"/>
			</requestFiltering>
		</security>
	</system.webServer>
</configuration>
