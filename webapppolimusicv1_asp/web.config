<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Enable detailed ASP errors for debugging -->
    <asp
      scriptErrorSentToBrowser="true"
      enableParentPaths="true"
      bufferingOn="true"
      errorsToNTLog="false" />
    <httpErrors errorMode="Detailed" />

    <!-- Default document: serve login.asp when visiting the site root -->
    <defaultDocument>
      <files>
        <clear />
        <add value="login.asp" />
        <add value="index.asp" />
        <add value="default.asp" />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
